# Normalise line endings so the repository is consistent regardless of the
# platform a contributor works on.
* text=auto eol=lf

# The Windows launcher must keep CRLF; the shell script must keep LF.
*.bat text eol=crlf
gradlew text eol=lf

# Binary assets: never normalise or diff these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary

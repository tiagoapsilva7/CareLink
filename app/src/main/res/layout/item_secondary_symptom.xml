<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_input_field"
    android:layout_marginTop="8dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Description:"
            android:textColor="@color/buttons"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_remove_sec"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/close"
            app:tint="@android:color/holo_red_dark" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_sec_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@android:color/transparent"
        android:hint="Describe the secondary symptom"
        android:textColorHint="#757575"
        android:textColor="@color/black" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Onset relative to main symptom:"
        android:textColor="@color/buttons"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <CheckBox
        android:id="@+id/cb_sec_same"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Same as the main symptom"
        android:textColor="@color/black"
        android:theme="@style/WhiteCheckTheme"/>

    <CheckBox
        android:id="@+id/cb_sec_after"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="After the main symptom"
        android:textColor="@color/black"
        android:theme="@style/WhiteCheckTheme"/>

    <EditText
        android:id="@+id/et_sec_time_after"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:background="@android:color/transparent"
        android:hint="How long after? (e.g. 2 hours)"
        android:textColorHint="#757575"
        android:textColor="@color/black"
        android:visibility="gone"/>

</LinearLayout>
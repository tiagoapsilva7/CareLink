<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_input_field"
    android:elevation="4dp"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <TextView
        android:id="@+id/tv_card_compound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/buttons"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_card_posology"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#555555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_card_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:textStyle="italic" />

    <LinearLayout
        android:id="@+id/ll_card_pdf_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_card_view_pdf"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/eye"
            app:tint="@color/buttons" />

        <ImageView
            android:id="@+id/iv_card_setup_notifications"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/bell"
            app:tint="@color/buttons" />

        <ImageView
            android:id="@+id/iv_card_remove_pdf"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/trash"
            app:tint="@android:color/holo_red_dark" />
    </LinearLayout>
</LinearLayout>